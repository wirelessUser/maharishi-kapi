import { RouterLink } from '@angular/router';

type Category = 'Astrology' | 'Numerology' | 'Tarot' | 'Vastu' | 'Palmistry' | 'Wellness';
type CategoryFilter = 'All' | Category;

interface Course {
  id: string;
  title: string;
  category: Category;
  image: string;
  price: number;
  originalPrice: number;
  description: string;
}

interface Faq {
  question: string;
  answer: string;
}

