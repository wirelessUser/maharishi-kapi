<!-- Masthead -->
<section class="bg-white pt-16 pb-8 border-b-4 border-kapi-purple">
    <div class="container mx-auto px-4 max-w-7xl text-center">
        <span class="text-kapi-saffron font-bold text-[11px] uppercase tracking-[0.35em]">The Maharishi Kapi</span>
        <h1 class="text-6xl md:text-7xl font-black text-kapi-purple font-serif tracking-tight mb-3">Journal</h1>
        <p class="text-gray-500 text-sm font-medium italic mb-8">Vedic wisdom, read like a magazine — not a listicle.</p>

        <nav class="flex flex-wrap justify-center gap-x-8 gap-y-3 border-t border-kapi-purple/10 pt-6">
            @for (category of categories; track category) {
                <button
                    type="button"
                    (click)="selectCategory(category)"
                    class="text-[12px] font-bold uppercase tracking-widest pb-1 border-b-2 transition"
                    [class.text-kapi-purple]="selectedCategory() === category"
                    [class.border-kapi-purple]="selectedCategory() === category"
                    [class.text-gray-400]="selectedCategory() !== category"
                    [class.border-transparent]="selectedCategory() !== category"
                >{{ category }}</button>
            }
        </nav>
    </div>
</section>

<!-- Featured cover story -->
<section class="bg-kapi-sand">
    <div class="container mx-auto px-4 max-w-7xl py-14">
        <a href="#" class="group grid grid-cols-1 lg:grid-cols-5 gap-0 rounded-[32px] overflow-hidden shadow-premium bg-white">
            <div class="lg:col-span-3 h-[280px] lg:h-[460px] overflow-hidden">
                <img [src]="featuredArticle.image" [alt]="featuredArticle.title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
            </div>
            <div class="lg:col-span-2 p-8 md:p-12 flex flex-col justify-center">
                <span class="text-kapi-saffron font-bold text-[10px] uppercase tracking-[0.25em] mb-4">{{ featuredArticle.category }} · Cover Story</span>
                <h2 class="text-2xl md:text-[32px] font-bold text-kapi-purple font-serif leading-[1.15] mb-4 text-balance group-hover:text-kapi-purpleHover transition-colors">{{ featuredArticle.title }}</h2>
                <p class="text-gray-500 text-[14px] leading-relaxed mb-8">{{ featuredArticle.deck }}</p>
                <div class="flex items-center gap-3 mt-auto">
                    <img [src]="featuredArticle.authorPhoto" [alt]="featuredArticle.author" class="w-10 h-10 rounded-full object-cover border-2 border-kapi-gold/40">
                    <div class="text-[12px]">
                        <p class="font-bold text-kapi-purple">{{ featuredArticle.author }}</p>
                        <p class="text-gray-400">{{ featuredArticle.date }} · {{ featuredArticle.readTime }}</p>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>

<!-- Main grid + trending sidebar -->
<section class="bg-white py-16">
    <div class="container mx-auto px-4 max-w-7xl grid grid-cols-1 lg:grid-cols-3 gap-14">

        <!-- Article grid -->
        <div class="lg:col-span-2">
            <h3 class="text-[13px] font-bold text-kapi-purple uppercase tracking-[0.2em] mb-6 pb-3 border-b border-kapi-purple/10">
                {{ selectedCategory() === 'All' ? 'Latest Stories' : selectedCategory() + ' Stories' }}
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10">
                @for (article of filteredArticles(); track article.slug; let i = $index) {
                    <a href="#" class="group" [class.sm:col-span-2]="i === 0">
                        <div class="overflow-hidden rounded-2xl mb-4" [class.h-64]="i === 0" [class.h-48]="i !== 0">
                            <img [src]="article.image" [alt]="article.title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                        </div>
                        <span class="text-kapi-saffron font-bold text-[10px] uppercase tracking-[0.2em]">{{ article.category }}</span>
                        <h4 class="font-bold text-kapi-purple font-serif leading-snug mt-2 mb-2 group-hover:text-kapi-purpleHover transition-colors" [class.text-xl]="i === 0" [class.text-[15px]]="i !== 0">
                            {{ article.title }}
                        </h4>
                        @if (i === 0) {
                            <p class="text-gray-500 text-[13px] leading-relaxed mb-3">{{ article.deck }}</p>
                        }
                        <p class="text-gray-400 text-[11px] font-semibold">{{ article.author }} · {{ article.readTime }}</p>
                    </a>
                }
            </div>
        </div>

        <!-- Trending sidebar -->
        <aside class="lg:col-span-1">
            <div class="bg-kapi-sand rounded-[28px] p-8 sticky top-24">
                <h3 class="text-[13px] font-bold text-kapi-rose uppercase tracking-[0.2em] mb-6">Trending This Week</h3>
                <ol class="space-y-6">
                    @for (article of trending; track article.slug; let i = $index) {
                        <li>
                            <a href="#" class="flex items-start gap-4 group">
                                <span class="font-serif font-black text-3xl text-kapi-purple/20 leading-none w-8 shrink-0">{{ (i + 1) < 10 ? '0' + (i + 1) : (i + 1) }}</span>
                                <div>
                                    <span class="text-kapi-saffron font-bold text-[9px] uppercase tracking-widest">{{ article.category }}</span>
                                    <h5 class="font-bold text-kapi-purple text-[13px] font-serif leading-snug mt-1 group-hover:text-kapi-purpleHover transition-colors">{{ article.title }}</h5>
                                </div>
                            </a>
                        </li>
                    }
                </ol>

                <div class="mt-10 pt-8 border-t border-kapi-purple/10">
                    <h4 class="font-bold text-kapi-purple font-serif text-lg mb-2">Get the Journal in your inbox</h4>
                    <p class="text-gray-500 text-[12px] mb-4">One email a week. No spam, just wisdom.</p>
                    <div class="flex flex-col gap-3">
                        <input type="email" placeholder="Your email address" class="bg-white border border-gray-200 rounded-xl px-4 py-3 text-[13px] focus:outline-none focus:border-kapi-purple text-gray-800 placeholder-gray-400">
                        <button type="button" class="bg-kapi-purple hover:bg-kapi-purpleHover text-white rounded-xl py-3 text-[12px] font-bold uppercase tracking-widest transition">Subscribe</button>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</section>
